+def parse_rf_raw(data):
+    """Parse RF IQ sample from json line.
+
+    Expected JSON:
+        {
+            "key": "cw_000001",
+            "iq": "/path/to/cw_000001.npy",
+            "spk": "CW"
+        }
+
+    The npy file must have shape [2, N]:
+        row 0 -> I
+        row 1 -> Q
+    """
+
+    for sample in data:
+        assert 'src' in sample
+
+        json_line = sample['src']
+        obj = json.loads(json_line)
+
+        assert 'key' in obj
+        assert 'iq' in obj
+        assert 'spk' in obj
+
+        key = obj['key']
+        iq_file = obj['iq']
+        spk = obj['spk']
+
+        try:
+            iq = np.load(iq_file)
+
+            if iq.ndim != 2 or iq.shape[0] != 2:
+                raise ValueError(
+                    f"{iq_file}: expected [2, N], got {iq.shape}"
+                )
+
+            iq = torch.from_numpy(
+                iq.astype(np.float32, copy=False)
+            )
+
+            yield {
+                'key': key,
+                'spk': spk,
+                'wav': iq,
+                # Fake field only for compatibility.
+                'sample_rate': obj.get('sample_rate', 20_000_000),
+            }
+
+        except Exception as ex:
+            logging.warning(
+                'Failed to read RF IQ {}: {}'.format(iq_file, ex)
+            )
+def random_chunk_rf(data, chunk_len=16384):
+    """Random crop/pad IQ tensor.
+
+    Input:
+        sample['wav']: [2, N]
+
+    Output:
+        sample['wav']: [2, chunk_len]
+    """
+
+    for sample in data:
+        iq = sample['wav']
+
+        assert iq.ndim == 2
+        assert iq.shape[0] == 2
+
+        length = iq.shape[1]
+
+        if length > chunk_len:
+            start = random.randint(
+                0,
+                length - chunk_len
+            )
+
+            iq = iq[:, start:start + chunk_len]
+
+        elif length < chunk_len:
+            pad_len = chunk_len - length
+
+            iq = torch.nn.functional.pad(
+                iq,
+                (0, pad_len),
+            )
+
+        # RMS normalization.
+        power = (
+            iq[0].pow(2) +
+            iq[1].pow(2)
+        ).mean()
+
+        rms = torch.sqrt(power + 1.0e-8)
+
+        iq = iq / rms
+
+        sample['wav'] = iq
+
+        yield sample
+
+def parse_rf_h5(data):
+    """
+    Parse complex IQ directly from Jammertest HDF5.
+
+    Manifest line example:
+
+    {
+        "key": "area1_0900000_00000",
+        "h5": "/path/Sample_Area1_0900000_0924999.h5",
+        "row": 0,
+        "spk": "Spoof"
+    }
+
+    Jammertest data row:
+        [I0, Q0, I1, Q1, ...]
+
+    Output:
+        wav: [2, N], float32
+    """
+
+    for sample in data:
+        assert 'src' in sample
+
+        try:
+            obj = json.loads(sample['src'])
+
+            assert 'key' in obj
+            assert 'h5' in obj
+            assert 'row' in obj
+            assert 'spk' in obj
+
+            key = obj['key']
+            h5_path = obj['h5']
+            row = int(obj['row'])
+            spk = obj['spk']
+
+            # Open -> read one row -> close.
+            # Safe for DataLoader multiprocessing.
+            with h5py.File(h5_path, 'r') as f:
+                raw = f['data'][row]
+
+            # raw shape: [263120]
+            # IQ samples: 131560 complex samples
+            i = raw[0::2].astype(
+                np.float32,
+                copy=False,
+            )
+
+            q = raw[1::2].astype(
+                np.float32,
+                copy=False,
+            )
+
+            iq = np.stack(
+                [i, q],
+                axis=0,
+            )
+
+            iq = torch.from_numpy(
+                iq
+            ).contiguous()
+
+            example = {
+                'key': key,
+                'spk': spk,
+                'wav': iq,
+
+                # Only metadata; do NOT resample RF.
+                'sample_rate': int(
+                    obj.get(
+                        'sample_rate',
+                        81_000_000,
+                    )
+                ),
+            }
+
+            yield example
+
+        except Exception as ex:
+            logging.warning(
+                'Failed RF H5 sample: %s',
+                ex,
+            )
+
